# Application
APP_NAME=SocialMediaBot
APP_ENV=production
APP_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Database — use your Supabase connection string (Settings → Database → URI)
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Redis — get from Upstash dashboard (free tier: 256MB)
REDIS_URL=redis://default:YOUR_PASSWORD@your-upstash-redis.upstash.io:6379

# Telegram — from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_URL=https://your-app.onrender.com/api/v1/telegram/webhook

# X (Twitter) — from developer.x.com
X_API_KEY=your_api_key
X_API_KEY_SECRET=your_api_key_secret
X_CALLBACK_URL=https://your-app.onrender.com/api/v1/auth/x/callback

# TikTok — from developers.tiktok.com
TIKTOK_CLIENT_KEY=your_client_key
TIKTOK_CLIENT_SECRET=your_client_secret
TIKTOK_CALLBACK_URL=https://your-app.onrender.com/api/v1/auth/tiktok/callback

# Instagram — from developers.facebook.com
INSTAGRAM_APP_ID=your_fb_app_id
INSTAGRAM_APP_SECRET=your_fb_app_secret
INSTAGRAM_CALLBACK_URL=https://your-app.onrender.com/api/v1/auth/instagram/callback

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me
